{
  "name": "content",
  "title": "Content Assets",
  "key": "slug",
  "group_by": "kind",
  "sort": ["kind", "slug"],
  "display": ["title", "kind", "audience", "status"],
  "export_columns": ["title", "kind", "vertical", "audience", "language", "location", "owner", "status", "updated", "notes"],
  "fields": [
    {"name": "slug", "type": "text", "required": true, "desc": "Short identifier"},
    {"name": "title", "type": "text", "required": true, "desc": "Asset name"},
    {"name": "kind", "type": "enum", "open": true, "required": true,
     "values": ["video", "deck", "doc", "landing", "post", "case-study", "template", "image"],
     "labels": {"video": "🎬 Video", "deck": "📊 Deck", "doc": "📄 Document",
                "landing": "🌐 Landing page", "post": "✍️ Post", "case-study": "🏆 Case study",
                "template": "🧩 Template", "image": "🖼️ Image/graphic"}},
    {"name": "vertical", "type": "enum", "open": true,
     "values": ["general"],
     "labels": {"general": "🌍 General"}},
    {"name": "audience", "type": "enum", "open": true, "required": true,
     "values": ["public", "prospect", "client", "internal"],
     "labels": {"public": "🌐 Public", "prospect": "🎯 Prospect",
                "client": "🤝 Existing client", "internal": "🔒 Internal only"},
     "desc": "Who this may be sent to"},
    {"name": "language", "type": "enum", "open": true, "values": ["en"],
     "labels": {"en": "English"}, "default": "en"},
    {"name": "location", "type": "text", "required": true, "desc": "Where the asset lives — path, Drive, repo, URL"},
    {"name": "url", "type": "url", "desc": "Direct link if public"},
    {"name": "owner", "type": "text", "required": true, "desc": "Who owns the content"},
    {"name": "status", "type": "enum", "required": true, "default": "draft",
     "values": ["draft", "review", "published", "outdated"],
     "labels": {"draft": "✏️ Draft", "review": "👀 In review", "published": "✅ Published", "outdated": "⚠️ Outdated"}},
    {"name": "updated", "type": "date", "desc": "Last content update"},
    {"name": "notes", "type": "text"}
  ]
}
