{
  "name": "secrets",
  "title": "Keys & Secrets — mapping only",
  "key": "slug",
  "sort": ["system", "slug"],
  "group_by": "system",
  "display": ["purpose", "owner", "storage", "rotated"],
  "export_columns": ["slug", "system", "purpose", "owner", "storage", "rotated", "rotate_every_days", "notes"],
  "fields": [
    {"name": "slug", "type": "text", "required": true},
    {"name": "system", "type": "text", "required": true, "desc": "Which system it belongs to"},
    {"name": "purpose", "type": "text", "required": true},
    {"name": "owner", "type": "text", "required": true},
    {"name": "storage", "type": "text", "required": true, "desc": "Where it is stored — .env / 1Password / GitHub Secrets"},
    {"name": "rotated", "type": "date", "desc": "Last rotation"},
    {"name": "rotate_every_days", "type": "number"},
    {"name": "notes", "type": "text"}
  ]
}
